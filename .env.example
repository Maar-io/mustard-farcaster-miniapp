# Copy this file to .env. .env is gitignored — do NOT commit it.

# Public base URL of the app (Cloudflare quick tunnel).
# Managed automatically by ./dev-up.sh — no need to edit by hand.
PUBLIC_HOST=

# JWKS URL for NS SAPP — this is where the SAPP's public keys are published, and where the NS will fetch them to verify signatures.
NS_JWKS_URL=
